POSTGRES_USER=postgres
# Never commit backend/.env. Replace every placeholder locally.
POSTGRES_PASSWORD=replace-with-local-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dms_db
CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=replace-with-installed-ollama-model

BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=replace-with-local-wallet-private-key
BLOCKCHAIN_CONTRACT_ADDRESS=replace-with-deployed-contract-address

JWT_SECRET_KEY=replace-with-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_ALLOW_ROLE_REGISTRATION=false

# Optional PostgreSQL client executable overrides for backup/restore verification.
# PG_DUMP_PATH=
# PSQL_PATH=
